{
  "manifest_version": 3,
  "name": "JobTrack - Job Application Tracker",
  "version": "1.0.0",
  "description": "Extract, verify, and track job applications across career portals and job boards.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Track Job Application"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
